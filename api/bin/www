#!/usr/bin/env node
const { app, migrate } = require('../app');

const port = process.env.PORT || 3000;

// The schema is applied before the server listens, so a pod never reports ready
// against a database it has not prepared. If it fails the process exits rather
// than serving 500s from a half-built schema — Kubernetes will restart it, and
// a CrashLoopBackOff is a clearer signal than a pod that is up and broken.
migrate()
  .then(() => {
    app.listen(port, () => console.log(`api listening on ${port}`));
  })
  .catch((err) => {
    console.error('startup failed:', err.message);
    process.exit(1);
  });
